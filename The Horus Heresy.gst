    <profile name="Shroud Bomb" id="17f3-89d3-0f42-1c09" hidden="false" page="183" publicationId="ca571888--pubN106502" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Shroud bombs count as defensive grenades in combat. In addition, with the exception of vehicles, Daemons, Gargantuan Creatures and units which have the Night Vision special rule, units must pass a Leadership test in order to charge a unit equipped with shroud bombs.</characteristic>
      </characteristics>
    </profile>
    <profile name="Haywire Greande (Shooting)" id="959f-9200-4602-e027" hidden="false" page="183" publicationId="ca571888--pubN106502" typeId="576561706f6e23232344415441232323" typeName="Weapon">
