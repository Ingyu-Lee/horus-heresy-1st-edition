        <profile name="Warlord Trait: Immovable Object" id="8b51-c91b-bd55-2d71" hidden="false" page="137" publicationId="ca571888--pubN106502" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Your Warlord has the Fearless and It Will Not Die special rules.</characteristic>
          </characteristics>
