    </profile>
    <profile name="Witchblade" id="3a00-c9d9-111e-037f" hidden="false" publicationId="ca571888--pubN106502" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
        <characteristic name="Strength" typeId="537472656e67746823232344415441232323">User</characteristic>
