            <characteristic name="Type" typeId="5.479706523232345e+27">Heavy 1, Ardex Machina</characteristic>
          </characteristics>
        </profile>
        <profile name="Sinistramanus Tenebrae" id="6872-5f31-61ad-b09e" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">120</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">D/X*/X**</characteristic>
