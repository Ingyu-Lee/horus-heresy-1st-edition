              </costs>
              <infoLinks>
                <infoLink name="Concussive" id="f964-925b-eedd-f137" hidden="false" targetId="9d85-46f7-f5e6-a5f7" type="rule"/>
                <infoLink name="Strikedown" id="10ff-7985-4c6b-2ccd" hidden="false" targetId="dd83-7fb9-6f58-0c96" type="rule"/>
                <infoLink name="Nemesis Quake Cannon" id="e568-c25d-1615-b590" hidden="false" targetId="4807-658a-4855-aa88" type="profile"/>
              </infoLinks>
              <rules>
                <rule name="Seismic Shock" id="5c15-bf8d-bf0d-65f6" hidden="false">
