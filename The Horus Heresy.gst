    <selectionEntryGroup name="Exotic Melee Weapons" id="befa-6205-342b-50d0" collective="false" hidden="true" import="true">
      <constraints>
        <constraint id="6f2c-a221-7fcd-0081" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="7bc1-b1dd-75fe-ca7e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="0"/>
      </constraints>
      <rules>
        <rule name="Exotic Melee Weapns" id="f282-aa46-1f1a-9a2b" hidden="false">
          <description>Any Independent Character may exchange a power fist for an Exotic Melee Weapon:</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Accelerator Hammer" id="e513-35eb-42d6-b685" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f8c9-edb1-827e-f1bd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Two-Handed" id="13ac-9615-177e-6319" hidden="false" targetId="b11c-0ef4-af6b-d96f" type="rule"/>
            <infoLink name="Sunder" id="bc59-5789-4551-2bf8" hidden="false" targetId="841f-9119-9f9d-5058" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Accelerator Hammer" id="f492-516c-3e7b-0310" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">+3</characteristic>
                <characteristic name="AP" typeId="4.1502323234441545e+23">1</characteristic>
                <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Two-handed, Sunder, Delayed Strike</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Delayed Strike" id="01df-981e-e795-9955" hidden="false">
              <description>The bearer of this weapon halves their Initiative and Attack value when using this weapon, rounding up.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Aetheric Shredder Knife" id="4dcf-3bd9-4e30-4fd6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b411-6c18-5760-9464" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <profiles>
            <profile name="Aetheric Shredder Knife" id="8ed0-e237-38ce-453b" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">User</characteristic>
                <characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic>
                <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Dimensional Edge</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Dimensional Edge" id="3d59-0a30-692e-464a" hidden="false">
              <description>Attacks from this weapon only ever cause wounds on a roll of 6, however no invulnerable saves or Feel No Pain rolls may be taken</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Arcanite Shock Maul" id="d729-1516-184f-764e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0d43-f455-ccc4-e728" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Concussive" id="9587-7447-9f4d-1f24" hidden="false" targetId="9d85-46f7-f5e6-a5f7" type="rule"/>
            <infoLink name="Two-Handed" id="4d8f-5d11-4e2a-b370" hidden="false" targetId="b11c-0ef4-af6b-d96f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Arcanite Shock Maul" id="32d6-4ade-0845-0f13" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">+3</characteristic>
                <characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic>
                <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Two-handed, Arcing Discharge</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Arcing Discharge" id="d9a1-6fee-7de6-8369" hidden="false">
              <description>Any model wounded by attacks from this weapon suffers the effects of the Concussive rule, whether the wound is saved or not.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Artificer Mirrorswords" id="9537-efdd-75e7-c362" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="99c2-46cf-1afd-03bb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Paired Weapons" id="035c-0d42-a42d-cae1" hidden="false" targetId="f495-679e-1976-68d1" type="rule"/>
            <infoLink name="Two-Handed" id="e0fa-0a2e-fda9-1b16" hidden="false" targetId="b11c-0ef4-af6b-d96f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Artificer Mirrorswords" id="5a62-5435-f1d2-c872" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">User</characteristic>
                <characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic>
                <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Riposte, Paired Weapons (+1 Attack)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Riposte" id="e9e8-b6d3-fac2-8a52" hidden="false">
              <description>Attacks directed at the wielder of these weapons suffer -1 to hit.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Bioceramic Razorglaive" id="12c5-f430-027c-d311" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="268c-3a52-40f8-cd2f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <profiles>
            <profile name="Bioceramic Razorglaive" id="def0-9aa9-41bd-33a2" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">User</characteristic>
                <characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic>
                <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Grants +1 Initiative, Brittle</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Brittle" id="1593-93a2-b6c8-570d" hidden="false">
              <description>If a user of this weapon hits with all of their attacks during a single round of combat, after resolving those attacks its AP value is reduced to (-) for the remainder of the battle.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Charnabal Longsword" id="7a4e-24ec-d6c3-271d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0192-5f8b-35c1-749b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
