      </characteristics>
    </profile>
    <profile name="Auxiliary Drive" id="c5c3-cf81-76c6-b0c0" hidden="false" page="131" publicationId="ca571888--pubN80998" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A vehicle with an auxiliary drive may repair Immobilised results it suffers on a D6 roll of 4+ at the start of the controlling player&apos;s Movement phase.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dozer Blade" id="35a2-2083-1522-cd61" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Vehicles equipped with dozer blades treat their front armour as one higher than normal when ramming. The vehicle can re-roll failed Dangerous Terrain tests.</characteristic>
      </characteristics>
    </profile>
    <profile name="Hunter-killer Missile" id="a117-de7b-6200-3076" hidden="false" publicationId="ca571888--pubN105292" typeId="576561706f6e23232344415441232323" typeName="Weapon">
