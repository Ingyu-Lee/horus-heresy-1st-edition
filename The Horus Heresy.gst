      <rules>
        <rule name="Plasma Overheat" id="1f44-916a-9413-cee3" hidden="false">
          <description>If this building suffers a glancing hit as a result of the plasma obliterator&apos;s Gets Hot special rule then, in addition to any other effects, any unit embarked in the building suffers D3 Wounds. These Wounds are Randomly Allocated.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Imperial Primus Redoubt" id="c05d-2231-2481-4037" collective="false" hidden="false" import="true" page="93" publicationId="ca571888--pubN80998" type="model">
      <costs>
        <cost name="pts" typeId="points" value="650"/>
      </costs>
      <entryLinks>
        <entryLink name="Obstacles List" id="b34f-574b-cdc5-2d17" collective="false" hidden="false" import="true" targetId="ad42-921f-358f-2970" type="selectionEntryGroup"/>
