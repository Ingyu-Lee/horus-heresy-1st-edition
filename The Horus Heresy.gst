                <characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic>
                <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Two-handed, Grants –2 Initiative</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Nanofractal Falchion" id="44fe-201d-d864-5ffb" collective="false" hidden="false" import="true" type="upgrade">
