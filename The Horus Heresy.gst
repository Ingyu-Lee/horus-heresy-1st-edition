    </profile>
    <profile name="Imperial Statuary" id="7571-d9f2-17b0-c3e0" hidden="false" publicationId="ca571888--pubN74520" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">A model from the Armies of the Imperium that is within 2&quot; of Imperial Statuary terrain has the Fearless special rule. A model in cover behind Imperial Statuary has a 3+ cover save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Inferno Cannon" id="585f-2120-0288-93b5" hidden="false" publicationId="ca571888--pubN106502" typeId="576561706f6e23232344415441232323" typeName="Weapon">
