          </costs>
          <infoLinks>
            <infoLink name="Two-Handed" id="dea4-fd4a-38b1-e160" hidden="false" targetId="b11c-0ef4-af6b-d96f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Hydragyros Executioner Blade" id="0937-2b49-dfe4-2893" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
