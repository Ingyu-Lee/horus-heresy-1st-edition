                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="fc71-c60e-a448-4de1" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
