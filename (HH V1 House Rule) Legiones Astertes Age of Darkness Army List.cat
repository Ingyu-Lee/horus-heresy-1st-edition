      <rules>
        <rule name="Keeper of the Keys" id="c6d8-6c48-836c-9c70" hidden="false" page="71" publicationId="ca571888--pubN113187">
          <description>If he is taken as a part of a detachment, then a single Dreadnought Talon may be taken as a non-compulsory HQ selection within that detachment. These Dreadnoughts may not be the Warlord.</description>
        </rule>
        <rule name="Warlord: Inspiring Presence" id="a619-1515-d4d5-af64" hidden="false">
          <description>All friendly units within 12&quot; of him may use his Leadership value rather than their own.</description>
        </rule>
      </rules>
