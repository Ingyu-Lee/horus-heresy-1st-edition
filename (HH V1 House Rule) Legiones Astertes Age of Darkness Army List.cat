        <profile name="AEtos Dios" id="f870-f01d-904c-d702" hidden="false" page="73" publicationId="ca571888--pubN80998" typeId="56656869636c6523232344415441232323" typeName="Vehicle">
          <characteristics>
            <characteristic name="BS" typeId="4.2532323234441546e+23">4</characteristic>
            <characteristic name="Front" typeId="46726f6e7423232344415441232323">12</characteristic>
            <characteristic name="Side" typeId="5.369646523232344e+27">12</characteristic>
            <characteristic name="Rear" typeId="5.265617223232345e+27">12</characteristic>
            <characteristic name="HP" typeId="4.8502323234441546e+23">9</characteristic>
            <characteristic name="Type" typeId="5.479706523232345e+27">Super-heavy Flyer (Hover, Transport)</characteristic>
          </characteristics>
        </profile>
        <profile name="Aetos Dios (Transport)" id="c7de-4eb6-8fca-f1da" hidden="false" publicationId="ca571888--pubN84656" typeId="307d-047f-ca13-706b" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="8285-4205-b6cd-8473">40 Models, may carry Legion Dreadnoughts and Comtemptor (counting as 10 models each and only disembarking on the main ramp), Jump Infantry, Bikes and Jetbikes</characteristic>
            <characteristic name="Fire Points" typeId="b270-a7f9-22b2-3702">None</characteristic>
            <characteristic name="Access Points" typeId="d17b-0342-b1dc-b8e7">One hatch on each side and a forward assault ramp</characteristic>
          </characteristics>
        </profile>
        <profile name="Void Shields (1)" id="b413-71f7-ec77-3be8" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Each hit scored against the vehicle will instead hit a Void Shield (whilst one remains active). Close Combat attacks come from within the shield and are not stopped. Void Shields have an armour value of 12. A Glancing or Penetrating hit or any hit from a Destroyer weapon causes it to collapse. After all void shields have collapsed, further hits strike the vehivle instead. At the end of each of the vehicles turns, roll a D6 for each collapsed Void Shield.  Each roll of a 5 restores one collapsed shield.</characteristic>
          </characteristics>
        </profile>
        <profile name="Invulnerable Save (4)" id="a69c-06c7-dc20-166d" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Invulnerable save of 4 against any Missile type weapon used against the AEtos Dios.</characteristic>
          </characteristics>
        </profile>
      </profiles>
