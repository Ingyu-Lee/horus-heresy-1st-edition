      <rules>
        <rule name="Special Issue Ammunition" id="3376-8a4e-a355-3135" hidden="false" page="48" publicationId="ca571888--pubN80998">
          <description>Seeker Space Marines are equipped with Kraken, Scorpius and Tempest bolt shells for their bolters (and combi-weapons where applicable), and may choose which to use each turn they fire.</description>
        </rule>
        <rule name="Marked for Death" id="8e27-703d-8305-4072" hidden="false" page="48" publicationId="ca571888--pubN80998">
          <description>After deployment, each Seeker unit may specify a single enemy unit or Independent Character as being &apos;Marked for Death.&apos;  The Legion Seeker unit now counts as having the Preferred Enemy special rule against the chosen target.</description>
        </rule>
      </rules>
