      <selectionEntries>
        <selectionEntry name="Icarian" id="6ce7-cbc0-365c-642b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0c9b-76b0-8cf5-e779" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
          </costs>
          <rules>
            <rule name="Icarian*" id="a741-f2f1-86c2-3432" hidden="false" page="39" publicationId="ca571888--pubN66489">
              <description>If stationary that turn, the Cohort may, if wished, count as having the
                                        Skyfire special rule for all its ranged weapons that turn. Units with this
                                        augment count as a Heavy Support choice instead of a troops choice for the army.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Ferrox" id="d48a-d06f-5332-ac4c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f0a4-d8f5-1536-30cc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
          </costs>
          <rules>
            <rule name="Ferrox" id="1bdd-f228-3945-bbee" hidden="false" publicationId="ca571888--pubN66489">
              <description>The unit gains the Rage rule and its close combat attacks (regardless of type) gain the Rending special rule. The unit may not be upgraded to replace
their lightning guns.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Destructor" id="6db2-d57d-8a51-089e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="20a9-f5a3-606a-28f2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
