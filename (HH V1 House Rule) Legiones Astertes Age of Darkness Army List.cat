      <profiles>
        <profile name="Kyr Vhalen" id="a290-ca9f-8379-c341" hidden="false" page="85" publicationId="ca571888--pubN113187" typeId="556e697423232344415441232323" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Infantry (Character)</characteristic>
            <characteristic name="WS" typeId="5.753232323444154e+23">6</characteristic>
            <characteristic name="BS" typeId="4.2532323234441546e+23">5</characteristic>
            <characteristic name="S" typeId="5.323232344415441e+21">4</characteristic>
            <characteristic name="T" typeId="5.423232344415441e+21">4</characteristic>
            <characteristic name="W" typeId="5.723232344415441e+21">4</characteristic>
            <characteristic name="I" typeId="4.923232344415441e+21">5</characteristic>
            <characteristic name="A" typeId="4.123232344415441e+21">4</characteristic>
            <characteristic name="LD" typeId="4c4423232344415441232323">10</characteristic>
            <characteristic name="Save" typeId="5.361766523232344e+27">2+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Shatter Assault" id="2619-80ba-aa5b-9ec1" hidden="false" page="85" publicationId="ca571888--pubN113187">
          <description>Once per game, Vhalen may declare the use of this ability when he or a unit he has joined is assaulted. For the duration of the Assault phase, all units which charge him are forced to make Disordered Charges and may not use Hammer of Wrath</description>
        </rule>
        <rule name="Master of Fortifications" id="cfc7-0bbf-8116-952c" hidden="false" page="85" publicationId="ca571888--pubN113187">
          <description>At the start of the game, Vhalen may nominate a single Fortification choice that was included in the army.  May decide whether to increase its armour by 1 (to max 15) or allow all failed Cover Saves results of &quot;1&quot; in the fortificatino to be re-rolled.</description>
        </rule>
        <rule name="Warlord: Battle Logistician" id="fb4f-70b8-0ec2-bf90" hidden="false">
          <description>If Vhalen is your army’s Warlord, he has the Battle Logistician trait rather than rolling randomly)

The Warlord may declare a single unit of any type that begins the game deployed on the table. While it remains in their own deployment zone, this unit may re-roll all To Hit rolls of ‘1’ with shooting attacks. This ability cannot be used, however, for weapons with the Gets Hot rule.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Warsmith" id="3023-69c8-2008-4f19" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="3d16-20b1-8e9e-0f41" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
