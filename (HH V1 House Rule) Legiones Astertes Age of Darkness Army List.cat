      <profiles>
        <profile name="Sevatar" id="97a1-3daf-1cef-7ff0" hidden="false" page="186" publicationId="690c-3e82-3080-6bc0" typeId="556e697423232344415441232323" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Infantry (Character</characteristic>
            <characteristic name="WS" typeId="5.753232323444154e+23">7</characteristic>
