      <rules>
        <rule name="Cunning Strategist" id="e047-8c02-ae9c-132d" hidden="false" page="236" publicationId="ca571888--pubN68042">
          <description>While Remus Ventanus is alive, the opposing player has a -1 modifier to all reserve rolls and the owning player may re-roll any reserves rolls (failed or successful).</description>
        </rule>
        <rule name="Warlord: Resoulte Planning" id="e6c8-296a-60ce-c044" hidden="false">
          <description>oth Captain Remus and units with the Legiones Astartes (Ultramarines) special rule in an army with Remus Ventanus as its Warlord have the Stubborn special rule while they have at least one model within 3&quot; of an objective.</description>
        </rule>
      </rules>
    </selectionEntry>
