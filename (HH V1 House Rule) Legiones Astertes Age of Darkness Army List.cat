    <selectionEntry name="Nemesis Ammunition (Bolter)" id="43b9-000f-f59a-413a" collective="false" hidden="false" import="true" publicationId="18fc-e8f3-462f-9e60" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <profiles>
        <profile name="Nemesis Ammunition (Bolter)" id="e376-203e-910f-34a2" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">18&quot;</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">4</characteristic>
            <characteristic name="AP" typeId="4.1502323234441545e+23">5</characteristic>
            <characteristic name="Type" typeId="5.479706523232345e+27">Assault 2, Harrower</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Harrower" id="eb64-dcb6-d4ed-4719" hidden="false">
          <description>Any To Wound roll of a 6 is resolved at AP 2. Additionally, any unit from which a model is removed as a casualty during the Shooting phase as a result of an attack from a weapon with this special rule, must take a Morale check as if they had suffered 25% casualties.</description>
        </rule>
      </rules>
    </selectionEntry>
