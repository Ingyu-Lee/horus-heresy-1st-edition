          <profiles>
            <profile name="Luminiferous Resonator" id="cd373701-efd9-95bf-dcdf-65e6ec404e38" hidden="false" page="227" publicationId="ca571888--pubN84158" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">12&quot;</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">10*</characteristic>
                <characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic>
                <characteristic name="Type" typeId="5.479706523232345e+27">Salvo 3/6</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Luminiferous Resonator" id="9101-e657-9a00-098a" hidden="false">
              <description>Strength value is compared to the target&apos;s Leadership instead of toughness. The weapon has no effect on vehicles or any model without a Leadership characteristic.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Conversion Dissonator" id="4371d797-676c-4497-c25c-c4eeb8397541" collective="false" hidden="false" import="true" page="227" publicationId="ca571888--pubN84158" type="upgrade">
