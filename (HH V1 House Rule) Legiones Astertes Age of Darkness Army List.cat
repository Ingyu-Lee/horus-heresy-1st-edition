    <profile name="Cortex Designator" id="a544-0b30-4b15-43ff" hidden="false" page="232" publicationId="ca571888--pubN89821" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">When a model with this wargear makes a successful shooting attack against an enemy unit, any automata in the same unit gain Preferred Enemy when targeting that same enemy unit until the end of the controlling player&apos;s current turn.</characteristic>
      </characteristics>
    </profile>
