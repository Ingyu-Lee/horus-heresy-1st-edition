            <characteristic name="Range" typeId="52616e676523232344415441232323">Template</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic>
            <characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic>
            <characteristic name="Type" typeId="5.479706523232345e+27">Assualt 1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Blood of Fire" id="aea4-7efc-ede6-c46a" hidden="false" page="69" publicationId="ca571888--pubN113187">
          <description>Vulkan may re-roll any failed It Will Not Die or Deny the Witch rolls.</description>
        </rule>
        <rule name="Sire of the Salamanders" id="6fb6-3958-c48f-a3b2" hidden="false" page="69" publicationId="ca571888--pubN113187">
          <description>All models with Legiones Astartes (Salamanders) gain 1 Leadership (to max 10) and Adamantium Will.</description>
        </rule>
      </rules>
