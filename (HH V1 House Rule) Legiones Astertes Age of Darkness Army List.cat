      <rules>
        <rule name="Burning Descent" id="2004ff54-0aa8-3b62-7e09-178e3ad7886b" hidden="false" page="75" publicationId="ca571888--pubN113187">
          <description>If arriving via Deep Strike, all models within D6&quot; suffer an immediate Strength 3 AP 5 hit.</description>
        </rule>
        <rule name="Scorched Earth" id="49ad5371-2d46-de03-d279-7785d1ae4814" hidden="false" page="75" publicationId="ca571888--pubN113187">
          <description>This unit may always use a Hammer of Wrath attack, regardless of whether or not it has used its jump pack in the Movement phase, and these attacks are carried out at Str 5. The Hammer of Wrath attacks made by this unit are classed as Flamer type attacks.</description>
        </rule>
        <rule name="Bitter Duty" id="a891ca94-0b5f-223f-399f-0291e2681f65" hidden="false" page="75" publicationId="ca571888--pubN113187">
          <description>May not be joined by Independent Characters</description>
          <modifiers>
            <modifier field="description" type="set" value="The unit may not be joined by friendly independent characters other than Legion Moritat or Legion Chaplain Consuls which are equipped with Jump packs and have the Legiones Astartes (Word Bearers) special rule.">
              <conditions>
                <condition childId="dace-8f0f-e696-8179" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </rule>
        <rule name="Grapple" id="44d9d420-f962-f2f5-6e65-e5666ef5fdbc" hidden="false" page="75" publicationId="ca571888--pubN113187">
          <description>Enemies attempting to fall back after losing an assault suffer -1 penalty.</description>
          <modifiers>
            <modifier field="description" type="set" value="A model equipped with a weapon with this special rule adds +1 to their Initiative for the purpose of making Sweeping Advances.">
              <conditions>
                <condition childId="dace-8f0f-e696-8179" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </rule>
      </rules>
