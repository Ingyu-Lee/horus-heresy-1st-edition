          </costs>
          <rules>
            <rule name="Augurs of Weakness" id="0768-5480-e25c-e2d2" hidden="false" page="159" publicationId="690c-3e82-3080-6bc0">
              <description>When making an Armour Pentration roll against a target with Armour 11 or more on the facing targeted, a model with this special rule may add plus 1 to the Strength of the weapon used to make the attack.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Icons of Resolve" id="cd8c-3564-f83e-50d4" collective="false" hidden="false" import="true" page="159" publicationId="690c-3e82-3080-6bc0" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <rules>
            <rule name="Icons of Resolve" id="7543-74d5-0cf9-202c" hidden="false" page="159" publicationId="690c-3e82-3080-6bc0">
              <description>This model gains plus 1 Attacks on any turn in which it, or a unit it is part of, is Charged by one or more enemy units.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Guardians of Sanctity" id="bfed-7f04-3caa-1186" collective="false" hidden="false" import="true" page="159" publicationId="690c-3e82-3080-6bc0" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <rules>
            <rule name="Guardians of Sanctity" id="c8d6-becd-38d1-e78a" hidden="false" page="159" publicationId="690c-3e82-3080-6bc0">
              <description>When making a Deny the Witch roll for a unit that includes this model, roll an additional d6 and discard the lower result before determining if the roll succeeds or fails.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Slayers of Kings" id="8d3e-bb5c-efa0-eaf3" collective="false" hidden="false" import="true" page="159" publicationId="690c-3e82-3080-6bc0" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <rules>
            <rule name="Slayers of Kings" id="63a8-204f-42bf-84ae" hidden="false" page="159" publicationId="690c-3e82-3080-6bc0">
              <description>This model may re-roll failed To Hit rolls of &apos;1&apos; when engaged in combat or in a Challenge with any model with a Weapon Skill of 5 or higher.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Hunters of Beasts" id="e915-4e75-bac3-24e3" collective="false" hidden="false" import="true" page="159" publicationId="690c-3e82-3080-6bc0" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <rules>
            <rule name="Hunters of Beasts" id="f0e0-2d25-4432-f2c5" hidden="false" page="159" publicationId="690c-3e82-3080-6bc0">
              <description>This model may re-roll failed To Wound rolls of &apos;1&apos; when engaged in combat with any model with a Toughness of 5, or any failed To Wound roll if the target&apos;s Toughness is 6 or higher.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Reapers of Hosts" id="2e27-76c9-4e48-1ea2" collective="false" hidden="false" import="true" page="159" publicationId="690c-3e82-3080-6bc0" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <rules>
            <rule name="Reapers of Hosts" id="d726-b385-f6e0-0ee3" hidden="false" page="159" publicationId="690c-3e82-3080-6bc0">
              <description>This model gains plus 1 Attack in any Fight sub-phase wheich they being in base contact with more than one enemy model.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Breakers of Witches" id="7df4-c7ee-468d-e8f8" collective="false" hidden="false" import="true" page="159" publicationId="690c-3e82-3080-6bc0" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <rules>
            <rule name="Breakers of Witches" id="bd43-c4ef-5be5-4378" hidden="false" page="159" publicationId="690c-3e82-3080-6bc0">
              <description>This model may re-roll all To Hit and To Wound rolls in close combat when attacking an enemy unit affected by a Blessing psychic power, or an enemy unit with either the Psyker or Brotherhood of Psykers/Sorcerers, Psychic Pilot, Daemon, or Daemon of the Ruinstorm special rules.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
