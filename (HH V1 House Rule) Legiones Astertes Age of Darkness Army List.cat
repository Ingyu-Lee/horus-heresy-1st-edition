                <profile name="Focused Bombardment" id="ca8f-48b2-da72-d887" hidden="false" page="237" publicationId="ca571888--pubN68042" typeId="576561706f6e23232344415441232323" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="52616e676523232344415441232323">Unlimited</characteristic>
                    <characteristic name="Strength" typeId="537472656e67746823232344415441232323">8</characteristic>
