        <profile name="Chem-munitions" id="d32f-746d-457e-9053" hidden="false" page="38" publicationId="ca571888--pubN113187" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">All flame weapons (flamers, Heavy flamers, hand flamers, combi-flamers, or Flamestorm Cannons) in a unit or on a vehicle may be upgraded to Chem-munitions.  All eligible weapons must be upgraded.    Weapons with this rule gain both Shred and Gets Hot special rules.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master-crafted Deathshroud Power Scythe" id="9c10-ba61-aaaf-22bc" hidden="false" page="86" publicationId="ca571888--pubN80998" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">1</characteristic>
            <characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic>
            <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Unwieldy, Two-handed, Sweep Attack, Master-crafted</characteristic>
          </characteristics>
        </profile>
        <profile name="Chem-bombardment" id="aa82-5ed7-7c7d-c418" hidden="false" page="45" publicationId="ca571888--pubN113187" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">Unlimited</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">-</characteristic>
            <characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic>
            <characteristic name="Type" typeId="5.479706523232345e+27">Ordnance 3, Barrage, Large Blast, Poison (4), No Cover Saves</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Warlord&apos;s Pride" id="49b7-d2ea-2d68-b2e3" hidden="false" page="34" publicationId="ca571888--pubN113187">
          <description>If Typhon is a part of the army, he will always be the warlord unless Mortarion is present.</description>
        </rule>
        <rule name="Chem-bombardment" id="1ec5-9b4f-2504-6f4b" hidden="false" page="45" publicationId="ca571888--pubN113187">
          <description>Once per game, this ability can be used in the shooting phase when Typhon has not moved during the movement phase.  Attack will always scatter full 2D6&quot;</description>
        </rule>
        <rule name="Witchblood" id="f4fc-5cde-ab35-ec56" hidden="false" page="45" publicationId="ca571888--pubN113187">
          <description>Typhon is a Leve 1 Psyker who may use an ability from the Telepathy discipline, but may not use his powers on the same battlefield as Mortarion before Mortarion&apos;s fall to Chaos.</description>
        </rule>
        <rule name="Warlord: Comes the Reaper" id="e392-a233-d040-b3f7" hidden="false">
          <description>Calas Typhon counts as a denial unit and no enemy unit within 3&quot; of him can claim an objective.</description>
        </rule>
      </rules>
    </selectionEntry>
