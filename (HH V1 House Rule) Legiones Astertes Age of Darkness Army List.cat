            <profile name="The Horned Raiment" id="7400-9975-fdae-7699" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">The Horned Raiment provides Magnus the Red with a +2 armour save and a 4+ Invulnerable save . In addition, if he is struck by a weapon with the Destroyer special rule, the amount of wounds it inflicts is reduced by 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
