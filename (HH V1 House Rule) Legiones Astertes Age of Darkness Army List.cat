      <rules>
        <rule name="Art of Destruction" id="1f79-108a-4114-20f8" hidden="false" page="43" publicationId="ca571888--pubN113187">
          <description>All attacks have the Tank Hunters and Wrecker special rules.  Additionally, Rask confers these rules to the heavy weapon shooting attacks of any infantry unit he joins.</description>
        </rule>
        <rule name="Warlord: Target Priority" id="c294-77dd-a32a-d561" hidden="false">
          <description>Durak Rask and all friendly units within 12&quot; re-roll To Hit rolls of 1 when shooting at enemy units that are within 3&quot; of one or more objectives.</description>
        </rule>
      </rules>
