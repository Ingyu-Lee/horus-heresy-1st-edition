      <profiles>
        <profile name="Lorgar" id="9a85-8214-0dfb-00d3" hidden="false" page="78" publicationId="ca571888--pubN113187" typeId="556e697423232344415441232323" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Infantry (Character)</characteristic>
            <characteristic name="WS" typeId="5.753232323444154e+23">6</characteristic>
            <characteristic name="BS" typeId="4.2532323234441546e+23">6</characteristic>
            <characteristic name="S" typeId="5.323232344415441e+21">6</characteristic>
            <characteristic name="T" typeId="5.423232344415441e+21">6</characteristic>
            <characteristic name="W" typeId="5.723232344415441e+21">5</characteristic>
            <characteristic name="I" typeId="4.923232344415441e+21">6</characteristic>
            <characteristic name="A" typeId="4.123232344415441e+21">4</characteristic>
            <characteristic name="LD" typeId="4c4423232344415441232323">10</characteristic>
            <characteristic name="Save" typeId="5.361766523232344e+27">2+</characteristic>
          </characteristics>
        </profile>
        <profile name="The Armour of the Word" id="7214-d88a-4354-a4d9" hidden="false" page="79" publicationId="ca571888--pubN113187" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Provides 2 armour and 4+ Invulnerable save, increasing to a 3 against psychic attacks, including Witchfire attacks and Force Weapons.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Sire of the Word Bearers" id="9e5f-63fe-5573-b2fa" hidden="false" page="79" publicationId="ca571888--pubN113187">
          <description>Lorgar confers Crusader to any unit he joins.  Additionally, while Lorgar is present and not in a transport, all models with Legiones Astartes (Word Bearers) may use Lorgar&apos;s leadership for all Morale Checks and Pinning tests.</description>
        </rule>
        <rule name="Living Icon" id="8c53-a756-f20b-acdf" hidden="false" page="79" publicationId="ca571888--pubN113187">
          <description>All models in the same detachment with Legiones Astartes (Word Bearers) who can draw line of sight to Lorgar gain 1 to their charge distance rolls, are immune to Fear and add 1 to their total score when determining assault results</description>
        </rule>
        <rule name="Dark Fortune" id="13d9-b4f0-9f95-e265" hidden="false" page="79" publicationId="ca571888--pubN113187">
          <description>Lorgar may re-roll any Deny the Witch rolls.  In addition, once per game Lorgar may force a single enemy model or unit to re-roll all rolls of 5, 6, or both To Hit and To Wound against Lorgar in a given player turn. This must be declared before any rolls are made.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Illiminarum" id="281e-915e-4421-bd20" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2b5b-323c-7b03-0331" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="5c87-efb2-3034-3bac" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
