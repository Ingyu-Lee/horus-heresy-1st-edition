    <profile name="Legion Standard" id="352f5f7a-45e0-0416-e7cd-1cb8f985b0ac" hidden="false" page="90" publicationId="ca571888--pubN80998" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
