                <characteristic name="AP" typeId="4.1502323234441545e+23">5</characteristic>
                <characteristic name="Type" typeId="5.479706523232345e+27">Assault 3, Lethal Precision</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Lethal Precision" id="d4c2-d847-841a-bb89" hidden="false" page="190" publicationId="690c-3e82-3080-6bc0">
              <description>Inflict precision strikes on a 4+ and on a To Wound roll of a 6 ignore both armour and invulnerable saves</description>
            </rule>
