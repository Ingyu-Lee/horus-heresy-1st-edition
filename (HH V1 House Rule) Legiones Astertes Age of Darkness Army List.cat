      <profiles>
        <profile name="Gorgon Pattern Terminator Armour" id="74204aac-6e27-3799-fce9-b8407a954e0e" hidden="false" page="50" publicationId="ca571888--pubN113187" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Same as normal Terminator Armour, but with additional special rule:  At the end of any phase in which a model has passed at least one armour or invulnerable save roll a single D6.  On a 4 all models within 6&quot; of the unit must test as if they had been hit by a weapon with Blind.  Friendly units may re-roll this test.</characteristic>
          </characteristics>
        </profile>
      </profiles>
