                    <profile name="Banner of the Eye" id="c9db-d1fb-fdc2-d524" hidden="false" page="234" publicationId="ca571888--pubN89821" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
                      <characteristics>
                        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">The traitor Herald and any traitor unit with the Legiones Astartes special rule within 12&quot; add 1 to their Charge and Run distances and may re-roll To Hit rolls of 1 in assault on any turn in which they have successfully charged.</characteristic>
                      </characteristics>
                      <modifiers>
                        <modifier field="hidden" type="set" value="true">
                          <conditions>
                            <condition childId="08ff-9734-7fbc-cb73" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                          </conditions>
                        </modifier>
                      </modifiers>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Fallen Honour" id="91b2-715e-b724-1fad" hidden="false" page="234" publicationId="ca571888--pubN89821">
                      <description>Should a Herald be slain, an additional victory point is scored by the opposing player where applicable.</description>
                    </rule>
                  </rules>
                </selectionEntry>
