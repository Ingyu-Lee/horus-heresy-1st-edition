                <characteristic name="Range" typeId="52616e676523232344415441232323">18&quot;</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic>
                <characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic>
                <characteristic name="Type" typeId="5.479706523232345e+27">Assault 1, Rending, Line of Effect</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Line of Effect" id="65ce-da42-1c9f-6768" hidden="false" page="69" publicationId="ca571888--pubN113187">
              <description>Draw a line from Vulkan 1mm wide and 18&quot; long to determine the weapons area of effect. All units crossed by the line suffer a number of hits equal to the number of models the line crosses.  May not be drawn over friendly models.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
