      <infoLinks>
        <infoLink name="Super-heavy Command Tank" id="f2cf-f729-58be-e3aa" hidden="false" targetId="aaaf-37f2-e6e0-7a2c" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="7358-de21-3ee3-1c8b" type="set" value="0">
          <conditions>
            <condition childId="ab4a-3c81-317e-9ad3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
          </conditions>
