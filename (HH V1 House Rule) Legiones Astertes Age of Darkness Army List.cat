                <profile name="Tarantula Sentry Gun" id="c54b-71b3-9c02-6de9" hidden="false" page="54" publicationId="ca571888--pubN80998" typeId="556e697423232344415441232323" typeName="Unit">
                  <characteristics>
                    <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Artillery (Immobile)</characteristic>
                    <characteristic name="WS" typeId="5.753232323444154e+23">-</characteristic>
                    <characteristic name="BS" typeId="4.2532323234441546e+23">3</characteristic>
                    <characteristic name="S" typeId="5.323232344415441e+21">-</characteristic>
