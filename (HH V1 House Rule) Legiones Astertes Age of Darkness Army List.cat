              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Conversion Dissonator" id="76c2-cecc-6146-b636" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Use of the conversion dissonator is declared at the start of any game turn, and is used for that one game turn only. While in effect, all invulnerable saves, applicable to friend and foe alike, within 12&quot; of the bearer suffer a modifier o f-2 (a save of s or 6 is negated entirely).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Zeroth Conductor Shield" id="e443542e-5253-9ad6-0179-b44fa84fd569" collective="false" hidden="false" import="true" page="227" publicationId="ca571888--pubN84158" type="upgrade">
