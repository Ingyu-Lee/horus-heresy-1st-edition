      <rules>
        <rule name="Opening Salvo" id="4b0e-606e-154f-7124" hidden="false" page="234" publicationId="ca571888--pubN68042">
          <description>On the turn in which the squad arrives via Deep Strike, it may fire its Pistol type weapons twice in the shooting phase.  It must be against the same target and Characters joining the unit do not gain this ability.</description>
        </rule>
        <rule name="Precision Intervention" id="698d-049b-cdc9-af1e" hidden="false" page="234" publicationId="ca571888--pubN68042">
          <description>When arriving via Deep Strike, the unit may re-roll the scatter dice.</description>
        </rule>
