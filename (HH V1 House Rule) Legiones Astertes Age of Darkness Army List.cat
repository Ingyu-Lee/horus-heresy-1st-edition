          <rules>
            <rule name="Sweeping Strike" id="78db-11dd-968f-35cb" hidden="false">
              <description>If a model using a weapon with this special rule is in base contact with more than one enemy model at the Initiative step in which they fight, they gain +1 Attack.</description>
