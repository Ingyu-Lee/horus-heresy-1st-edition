            <infoLink name="Master-crafted" id="a0d0-d588-9667-9b66" hidden="false" targetId="f899-8f9d-fc7e-d855" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Illuminarum" id="69a4-1c7b-c193-f8a2" hidden="false" page="79" publicationId="ca571888--pubN113187" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
