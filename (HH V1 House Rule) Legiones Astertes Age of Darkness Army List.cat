      <rules>
        <rule name="Battle Speed" id="9877-af46-2c99-b1cb" hidden="false" page="81" publicationId="ca571888--pubN80998">
          <description>When the Malcador Assault Tank moves Flat Out in the Shooting phase, it may choose to fire its traverse-mounted weapon at its full Ballistic Skill, either before or after the Flat Out move, but may fire no other weapons.</description>
        </rule>
        <rule name="Lumbering Behemoth (Mournival)" id="013b-ace3-f3a5-fd22" hidden="true">
          <description>If the tank only moves 6” or less it may fire all of its weapons at full BS (ignoring that Ordnance weapons cause snap shots).</description>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="8d39-af5d-fcc9-9c1f" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </rule>
      </rules>
