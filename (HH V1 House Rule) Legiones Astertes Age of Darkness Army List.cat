        <profile name="Desperate for Glory" id="3d6c-e3fd-037e-c3df" hidden="false" page="248" publicationId="ca571888--pubN89821" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">When the controlling player of an army with Skorr as its Warlord rolls for variable game length or any other rule that determines if another game turn is played, they may choose to automatically play another turn instead of rolling.  For the duration of that game turn, Autilion Skorr gains Feel No Pain (3) and Fearless.</characteristic>
          </characteristics>
        </profile>
        <profile name="Autilon Skorr: Warlord" id="5249-9c0a-57c8-a3c6" hidden="false" page="248" publicationId="ca571888--pubN89821" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">If acting as the Army&apos;s Warlord and choosing a Strategic trait from the 40k BRB, may choose a trait rather than roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
