            <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Shred, Rampage, Reaping Blow</characteristic>
          </characteristics>
        </profile>
        <profile name="The Voice of Terra" id="5874-3916-7268-e532" hidden="false" page="103" publicationId="ca571888--pubN113187" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">24&quot;</characteristic>
