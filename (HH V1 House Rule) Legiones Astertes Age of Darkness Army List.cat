    <profile name="Sonic Shrieker" id="580dd5a9-f85d-c9f3-eeff-e72d970ad9e5" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Models with a Sonic Shrieker imposes a -1 WS penalty on enemy models in base contact in assault.  Enemies which are immune to Fear are also immune to this effect.</characteristic>
      </characteristics>
    </profile>
    <profile name="Tartaros Terminator Armour" id="48ee-9a7f-07f1-22d0" hidden="false" page="133" publicationId="ca571888--pubN80998" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Terminator armour affords a +2 armour save and a 5+ Invulnerable save.  Maodels in Tartarus armour may make Sweeping Advances in combat unlike other patterns of Terminator armour. If a model with Tartarus pattern armour is joined by a character equipped with a different pattern of Terminator armour or vice versa, this ability is lost.</characteristic>
      </characteristics>
    </profile>
    <profile name="Tempest Bolt Shells" id="345c9b22-c89e-3234-d710-9b9262a1fd38" hidden="false" page="85" publicationId="ca571888--pubN80998" typeId="576561706f6e23232344415441232323" typeName="Weapon">
