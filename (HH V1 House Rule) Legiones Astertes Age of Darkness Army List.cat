            <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Shred, Sever Life</characteristic>
          </characteristics>
        </profile>
        <profile name="The Axe of Helwinter" id="4416-a1ab-c229-2845" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
