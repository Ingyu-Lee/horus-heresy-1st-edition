              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">1</characteristic>
                <characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic>
                <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Rending, Bloody Ruin</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Bloody Ruin" id="c5e5-70c2-7d03-8148" hidden="false">
              <description>Every wound caused bv the bearer of the fractal harrow-blade is counted as two wounds for the purposes of determining assault results.</description>
            </rule>
          </rules>
