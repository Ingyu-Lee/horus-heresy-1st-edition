    <selectionEntry name="Castellax-Achea Battle Maniple" id="6d32-367f-96df-dce6" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Monstrous Creature:" id="3e82-1db3-4a8f-eba9" hidden="false" primary="false" targetId="76fd-6b81-bded-bb25"/>
      </categoryLinks>
