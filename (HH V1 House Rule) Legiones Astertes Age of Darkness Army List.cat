                    <profile name="Banner of the Aquila" id="1f2f-ade8-ebc6-e020" hidden="false" page="234" publicationId="ca571888--pubN89821" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
                      <characteristics>
                        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">The Loyalist Herald and any Loyalist unit with the Legiones Astartes rule within 12&quot; add 1 to their WS to a max of 5.</characteristic>
                      </characteristics>
                      <modifiers>
                        <modifier field="hidden" type="set" value="true">
                          <conditions>
