      <rules>
        <rule name="Venerable" id="a339-d2cb-ff60-e96e" hidden="false" page="32" publicationId="ca571888--pubN113187">
          <description>May force results on the Vehicle Damage chart to be re-rolled. If this is done, the second result applies, even if it is worse than the first!</description>
        </rule>
        <rule name="Mantle of Glory" id="388a-9397-2b3e-5715" hidden="false" page="32" publicationId="ca571888--pubN113187">
          <description>Units with Legiones Astartes (Emperor&apos;s Children) on the same side as Rylanor within 24&quot; may re-roll failed Morale Checks and add 1 to combat results.</description>
        </rule>
      </rules>
