            <characteristic name="Save" typeId="5.361766523232344e+27">2+</characteristic>
          </characteristics>
        </profile>
        <profile name="The Dreadbringer&apos;s Plate" id="fc28-2f3e-dedd-0152" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">The Dreadbringer’s Plate grants a 2+ armour save and a 4+ Invulnerable save. In addition, against any weapon with the Crawling Fire or Melta special rules, this Invulnerable save is increased to 2+ and any weapon with the Poisoned special rule can only wound Farith Redloss on the roll of 6+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Warlord Trait: Master of Destruction" id="4b3b-74a7-a642-4065" hidden="false">
          <description>Farith Redloss has the Tank Hunters and Wrecker special rules applied to all of his Shooting attacks, and also confers these rules to the Heavy weapon shooting attacks of any Infantry unit he joins.</description>
        </rule>
      </rules>
