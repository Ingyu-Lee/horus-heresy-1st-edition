    <selectionEntryGroup name="May be upgraded with one of the following augment upgrades:" id="2f76-536e-c871-231d" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="b176-c59f-d025-4b19" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
