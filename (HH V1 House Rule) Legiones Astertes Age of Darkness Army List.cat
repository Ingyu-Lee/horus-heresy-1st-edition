        <profile name="Azurda Char&apos;is" id="3a60-bf2d-81bf-57ef" hidden="false" page="250" publicationId="ca571888--pubN68042" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">2</characteristic>
            <characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic>
            <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Force, Two-handed</characteristic>
          </characteristics>
        </profile>
        <profile name="Panoply of Flame" id="4829-d941-0088-5c53" hidden="false" page="250" publicationId="ca571888--pubN68042" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">All models with Legiones Astartes (Word Bearers) rule within 12&quot; add a 1 modifier for combat resolution and sweeping advance rolls.  Additionally in lieu of making one of Layak&apos;s normal shooting attacks, the Panoply may be used as if it were a Heavy Flamer once per game.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Zardu Layak" id="438f-355e-951e-aba6" hidden="false"/>
        <rule name="Psyker Level 2" id="d8a3-9e68-067d-eda6" hidden="false" publicationId="ca571888--pubN84656">
          <description>Psyker (Mastery Level 2) Zardu Layak may only generate psychic powers from the Pyromancy or Daemonology – Malefic Powers disciplines.</description>
        </rule>
        <rule name="Binder of Souls" id="687d-74ba-73b8-d074" hidden="false" page="250" publicationId="ca571888--pubN68042">
          <description>Counts as a Diabolist.  In addition, units in an army containing Layak may benefit from the Dark Channelling special rule with a 1 modifier on the Dark Channelling table.  If an army has Layak as its Warlord, then it may take an allied detachment from Codex: Chaos Daemons.</description>
        </rule>
        <rule name="Warlord: Reign of Fire" id="1773-680b-c710-c5d0" hidden="false">
          <description>If Zardu Layak is the army’s Warlord, then Ashen Circleunits may be taken as Troops choices for the army’s primarydetachment instead of Fast Attack choices and becomes a scoring unit. In addition, if taken, these units must be given the Dark Channelling upgrade at a cost of 25 points per squad.</description>
        </rule>
      </rules>
