          <conditions>
            <condition childId="dbf2-d8be-0406-b8d6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Pariah Power Armour" id="5627-cf8a-85cf-a375" hidden="false" page="222" publicationId="ca571888--pubN89821">
          <description>Confers a +3 armour save that drops to a 5 against weapons with a Strength of 6 or higher whose AP is not sufficient to bypass the armour normally.  Models with this armour may Snap Shot with Pistol, Rapid Fire, and Assault weapons in the same Shooting phase in which they have Run, shooting once the movement is complete.</description>
        </rule>
      </rules>
    </selectionEntry>
