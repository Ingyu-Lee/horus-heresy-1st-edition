      <selectionEntryGroups>
        <selectionEntryGroup name="Psychic Power" id="f5d2-5fe4-d5cf-242b" collective="false" defaultSelectionEntryId="6e74-fcf5-8c5e-b7aa" hidden="false" import="true">
          <constraints>
            <constraint id="2372-e3b0-7aa8-a008" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="328d-3300-e178-9e47" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Lorgar Transfigured" id="6e74-fcf5-8c5e-b7aa" collective="false" hidden="false" import="true" page="0" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="75"/>
              </costs>
              <rules>
                <rule name="Lorgar Transfigured" id="f7c1-eb70-4e49-2938" hidden="false" page="255" publicationId="ca571888--pubN68042">
                  <description>Lorgar is a Level 3 Psyker who may select rather than roll three powers in any combination from Divination and Telekinesis disciplines at the start of the game.  When manifesting powers, Lorgar harnesses warp charges on a 3 instead of a 4.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Erratic Psychic Power" id="c4a9-d9ef-c1bc-2914" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <rules>
                <rule name="Erratic Psychic Power" id="119c-489e-5ad9-9e2e" hidden="false">
                  <description>Lorgar is a Level 2 Psyker who may choose to roll powers from either the Divination or Telekinesis Disciplines. When wishing to manifest his powers, Lorgar successfully harnesses Warp Charge on rolls of 5 rather than 4 as would normally be the case.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
