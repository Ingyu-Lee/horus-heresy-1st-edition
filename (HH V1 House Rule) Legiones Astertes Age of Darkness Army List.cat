                  </conditions>
                </modifier>
              </modifiers>
            </infoLink>
          </infoLinks>
          <modifiers>
            <modifier field="name" type="set" value="Command Company Nuncio-vox">
              <conditions>
                <condition childId="3aaa-366b-7265-5402" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Command Company Nuncio-vox" id="48c0-02c8-a254-42e2" hidden="true" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Units arriving via Deep Strike within 6&quot;  of a Command Company Nuncio-vox do not scatter.  When barrage weapons are used by the controlling player, line of sight may be drawn from any model equipped with a Nuncio-vox as well as the firing model itself. Range is still drawn from the firing model.  It may not be used inside a vehicle.
Any unit equipped with a Command Company Nuncio Vox can benefit from the Cognis Signum carried by the Master of Signals (but still only one unit per turn)</characteristic>
              </characteristics>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="3aaa-366b-7265-5402" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
            </profile>
          </profiles>
        </selectionEntry>
