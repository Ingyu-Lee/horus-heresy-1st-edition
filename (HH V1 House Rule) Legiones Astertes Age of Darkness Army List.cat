        <profile name="The Draken Scale" id="0e71-72c2-4c56-7e4d" hidden="false" page="69" publicationId="ca571888--pubN113187" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Provides 2 armour and 3+ Invulnerable save and halves (rounding down) the strength of any flamer, fusion, volkite, melta, or plasma weapon used against him.</characteristic>
          </characteristics>
        </profile>
        <profile name="Heavy Flamer (St 6)" id="8fe7-3d8f-21fe-fff1" hidden="false" page="68" publicationId="ca571888--pubN113187" typeId="576561706f6e23232344415441232323" typeName="Weapon">
