            <characteristic name="HP" typeId="4.8502323234441546e+23">12</characteristic>
            <characteristic name="Type" typeId="5.479706523232345e+27">Super-heavy Flyer (Hover, Transport)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Shield Projection" id="270c-043c-c36a-cf9e" hidden="false" page="217" publicationId="ca571888--pubN68042">
          <description>So long as the Sokar is in Hover mode and remains stationary, it may declare that it is projecting its void shields at the start of their turn.  They extend 12&quot; from the main hull and wings.</description>
        </rule>
        <rule name="Reinforced Structure" id="9e52-9184-6a0e-2560" hidden="false" page="217" publicationId="ca571888--pubN68042">
          <description>Confers a 5+ Invulnerable against any attacks that have breached its void shields.</description>
        </rule>
      </rules>
