        <entryLink name="&apos;Iron Circle&apos; Domitar-Ferrum Class Battle-automata Maniple" id="367a-5ccd-6989-a354" collective="false" hidden="true" import="true" targetId="a9bf-b37e-126b-a699" type="selectionEntry">
