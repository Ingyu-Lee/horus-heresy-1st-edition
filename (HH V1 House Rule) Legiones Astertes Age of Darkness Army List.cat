      <rules>
        <rule name="Legion Inductees" id="cadc-883d-22d0-d133" hidden="false" page="22" publicationId="ca571888--pubN80998">
          <description>The unit of Battle-automata to which the Legion Praevian is attached gains the Legiones Astartes special rule possessed by the Legion Praevian or one of the following special rules: Furious Charge, Tank Hunters or Scout (when the Scout special rule is selected, it also applies to the Legion Praevian). These special rules are selected at no additional points cost.</description>
        </rule>
      </rules>
