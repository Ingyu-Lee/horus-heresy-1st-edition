        <profile name="The Armour Elavagar" id="c419-ba87-be2e-5854" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">The Armour Elavagar gives its wearer a +2 armour save and a 4+ Invulnerable save (which is increased to 3 against flamer, melta and plasma weapons of any kind). In addition, enemy models in base contact with Leman Russ at their Initiative step of the Fight sub-phase suffer a -1 penatly to Hit in assault, increaing to a -2 penalty if they have been in base contact for more than one turn of close combat.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Sword of Balenight" id="2c5a-9e70-bad8-6579" hidden="false" publicationId="ca571888--pubN92115" typeId="576561706f6e23232344415441232323" typeName="Weapon">
