      <rules>
        <rule name="Valour&apos;s Shadow" id="5fe6-4b91-7d7f-21c9" hidden="false" page="184" publicationId="690c-3e82-3080-6bc0">
          <description>Nakrid Thole may not be targeted by means of the Precision Strike/Precision Shots special rules. In addition, when Nakrid Thole is reduced to 0 Wounds, the controlling player must roll a D6. If the result is a 5+ then the model is still removed from play, But does not count as being destroyed for the purposes of Scoring Victory points of achieving Objectives. Once removed from play due to this rules, Nakrid Thole may not re-enter play for any reason.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Nostraman Flay-whip" id="1390-7d8e-2769-6218" collective="false" hidden="false" import="true" page="184" publicationId="690c-3e82-3080-6bc0" type="upgrade">
          <constraints>
