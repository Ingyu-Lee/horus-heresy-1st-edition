      </profiles>
      <rules>
        <rule name="Lone Killer" id="f878-bf81-df3c-4a8d" hidden="false" page="92" publicationId="ca571888--pubN113187">
          <description>Exodus may not be taken as a compulsory HQ choice, only as an optional HQ choice. He may not be the army’s Warlord, and may not join other units except Legion Reconnaissanc squads or Alpha Legion Headhunter Kill Teams.</description>
        </rule>
        <rule name="Assassin&apos;s Shot" id="db48-b581-69a2-31ce" hidden="false" page="92" publicationId="ca571888--pubN113187">
          <description>On any To Hit roll of 4+ for a shooting attack, Exodus’ controlling player may choose which model in an enemy unit is hit rather than following the usual procedure for assigning hits and saves, so long as the chosen model is within line of sight</description>
        </rule>
      </rules>
