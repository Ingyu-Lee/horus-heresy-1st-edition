      <rules>
        <rule name="Brutal Charge" id="8ea2-1d5a-604b-15b9" hidden="false" page="233" publicationId="ca571888--pubN68042">
          <description>Inflicts D3 Hammer of Wrath attacks on the charge</description>
        </rule>
        <rule name="Living Icon of the Legion" id="c1f3-74ba-2b87-e32d" hidden="false" page="233" publicationId="ca571888--pubN68042">
          <description>Units with the Legiones Astartes (Ultramarines) with at least one model within 12&quot; of Honoured Telemachus gain 1 to their Assault Resolution score and add 1&quot; to their sweeping advance rolls.</description>
        </rule>
        <rule name="Resiliant" id="9b6e-0620-9506-8945" hidden="false" page="233" publicationId="ca571888--pubN68042">
          <description>Whenever he suffers a Penetrating hit, the owning player may ask the opponent to re-roll the result on the vehicle damage or destroyer damage charts.</description>
        </rule>
        <rule name="Wrath in Betrayal" id="ab6a-f6eb-8b5d-a21b" hidden="false" page="233" publicationId="ca571888--pubN68042">
          <description>Confers Hatred (Traitor Legiones Astartes) rule, which applies to all units from Traitor Legiones Astartes forces.</description>
        </rule>
      </rules>
