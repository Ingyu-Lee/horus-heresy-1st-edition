            <characteristic name="S" typeId="5.323232344415441e+21">7</characteristic>
            <characteristic name="Front" typeId="46726f6e7423232344415441232323">13</characteristic>
            <characteristic name="Side" typeId="5.369646523232344e+27">12</characteristic>
