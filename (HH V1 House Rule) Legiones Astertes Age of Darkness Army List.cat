          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Beast (Character)</characteristic>
            <characteristic name="WS" typeId="5.753232323444154e+23">5</characteristic>
            <characteristic name="BS" typeId="4.2532323234441546e+23">0</characteristic>
            <characteristic name="S" typeId="5.323232344415441e+21">5</characteristic>
            <characteristic name="T" typeId="5.423232344415441e+21">5</characteristic>
            <characteristic name="W" typeId="5.723232344415441e+21">4</characteristic>
            <characteristic name="I" typeId="4.923232344415441e+21">5</characteristic>
