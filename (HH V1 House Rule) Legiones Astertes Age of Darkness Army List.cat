        <profile name="The Auric Armour" id="246e-410a-5133-d316" hidden="false" page="103" publicationId="ca571888--pubN113187" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Provides 2 armour and 4+ Invulnerable save. Additionally, no attack may wound Rogal Dorn on better than a 3 regardless of its Strength or special rules.  D weapons not affected.</characteristic>
          </characteristics>
        </profile>
        <profile name="Storm&apos;s Teeth" id="b470-f4ce-9548-30c7" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
