            <infoLink name="Murderous Strike" id="8a99-4722-a92c-c91c" hidden="false" targetId="b0c5-b980-95e5-b181" type="rule"/>
            <infoLink name="Master-crafted" id="379a-bc17-8df8-067e" hidden="false" targetId="f899-8f9d-fc7e-d855" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="The Devils Due" id="993a-6601-7868-6be8" hidden="false" page="184" publicationId="690c-3e82-3080-6bc0" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">+2</characteristic>
                <characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic>
                <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Unwieldy, The Devil&apos;s Due, Muderous Strike, Master-crafted</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="The Devils Due" id="c59f-4727-6575-b9e6" hidden="false" page="184" publicationId="690c-3e82-3080-6bc0">
              <description>If an enemy model in base contact with this model has its Initiative value reduced by the effects of any other weapon of special rule then this model may make a single additional attack against the enemy model. This additional attack is make Immediatly before the enemy model would attack and uses the profile for the Devil&apos;s Due shown above.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
