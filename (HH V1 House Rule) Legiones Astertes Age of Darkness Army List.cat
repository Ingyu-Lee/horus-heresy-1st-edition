        <rule name="Warlord: Dark Oratory" id="abff-3cfe-e0d7-1d35" hidden="false">
          <description>While Kor Phaeron is in play, all units with the Legiones Astartes (Word Bearers) special rule in his primary detachment gain a 1 bonus to their Leadership (to a maximum of Leadership 10).</description>
        </rule>
