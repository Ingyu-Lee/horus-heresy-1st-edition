      <rules>
        <rule name="The Harrowing" id="ed04-0bc1-87a0-c256" hidden="false" page="92" publicationId="ca571888--pubN113187">
          <description>While in the enemy deployment zone, all units with Legiones Astartes (Alpha Legion) as well as Alpha Legion Dreadnoughts may re-roll sweeping advances and add 1 results they inflict on the Vehicle Damage table.</description>
        </rule>
        <rule name="Weapon Mastery" id="04bc-347d-badc-1bcc" hidden="false" page="92" publicationId="ca571888--pubN113187">
          <description>May use both his close combat weapons and split his attacks between them as desired.</description>
        </rule>
        <rule name="Warlord: Hammerstrike Assault" id="4f90-6428-a9ea-fc97" hidden="false">
          <description>One chosen infantry unit in the same primary detachment as the Warlord gains the Deep Strike rule if it did not already possess it, and may re-roll the Deep Strike Scatter dice on the turn it arrives.</description>
        </rule>
        <rule name="Hammerstrike Assault" id="13f2-9950-877e-4122" hidden="false">
          <description>One chosen infantry unit in the same primary detachment as the Warlord gains the Deep Strike rule if it did not already possess it, and may re-roll the Deep Strike Scatter dice on the turn it arrives.</description>
        </rule>
      </rules>
