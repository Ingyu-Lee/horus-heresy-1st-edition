          <profiles>
            <profile name="Nostraman Flay-whip" id="4c7a-005c-8d18-618a" hidden="false" page="184" publicationId="690c-3e82-3080-6bc0" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">User</characteristic>
                <characteristic name="AP" typeId="4.1502323234441545e+23">4</characteristic>
                <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Rending, Electro-charge, Web of Steel, Specialist Weapon</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Electro-charge" id="5dc8-575e-1aea-1a05" hidden="false" page="184" publicationId="690c-3e82-3080-6bc0">
              <description>Any model that suffers an unsaved wound from this weapon reduces its Initiative value to 1 until the end of its controlling player&apos;s next turn.</description>
            </rule>
            <rule name="Web of Steel" id="5fd9-d513-35bb-acbe" hidden="false" page="184" publicationId="690c-3e82-3080-6bc0">
              <description>A model equipped with a melee weapon with this special rule may choose to forfeit all of its normal attacks in order to make a single attack against each enemy model from the unit that it is locked in combat with an within 2&quot; of the wielder, using the Flay-whip&apos;s profile. If this option is used then the Electro-charge special rule cannot trigger from unsaved wounds.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="The Devils Due" id="0800-99e6-b220-1819" collective="false" hidden="false" import="true" page="184" publicationId="690c-3e82-3080-6bc0" type="upgrade">
          <constraints>
            <constraint id="a7d4-1486-2d19-bb38" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="51e8-2b02-5026-a22b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <infoLinks>
