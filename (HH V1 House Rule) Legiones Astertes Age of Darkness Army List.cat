    <profile name="Terminator Armour" id="4791-ed93-bcc1-a7ed" hidden="false" page="133" publicationId="ca571888--pubN80998" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Terminator armour affords a +2 armour save and a 5+ Invulnerable save. Depending on its particular pattern, Terminator armour may also confer additional rules and abilities to its wearer.</characteristic>
