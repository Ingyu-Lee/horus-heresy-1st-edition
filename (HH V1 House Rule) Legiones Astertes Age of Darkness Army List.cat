                    <condition childId="e34d-ffe8-9f2d-e0bd" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
                    <condition childId="dffc-d31c-9a13-2f35" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
                    <condition childId="3aaa-366b-7265-5402" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
                    <condition childId="e77c-43f9-71c0-a632" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
                    <condition childId="ff1a-d870-cbd8-fe91" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
              <conditions>
                <condition childId="eb17-93bc-bd75-4579" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
                <condition childId="2241-f7c0-d1e3-20cd" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
        <modifier field="c793-6437-8d05-a9d1" type="set" value="0">
          <conditionGroups>
            <conditionGroup type="or">
              <conditions>
                <condition childId="4e06-f510-5de0-195b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="instanceOf" value="0"/>
                <condition childId="dbf2-d8be-0406-b8d6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
        <modifier field="a77b-7d4a-9dee-e188" type="set" value="0">
          <conditionGroups>
            <conditionGroup type="or">
              <conditions>
                <condition childId="4e06-f510-5de0-195b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="instanceOf" value="0"/>
                <condition childId="dbf2-d8be-0406-b8d6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
        <modifier field="hidden" type="set" value="true">
          <conditionGroups>
            <conditionGroup type="or">
              <conditions>
                <condition childId="4e06-f510-5de0-195b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="instanceOf" value="0"/>
                <condition childId="dbf2-d8be-0406-b8d6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
