              <rules>
                <rule name="Murderous Strike (5+)" id="346a-3565-cd16-6e0b" hidden="false" page="0">
                  <description>Causes Instant Death on a To Wound roll of 5</description>
                </rule>
                <rule name="Fireblade (Pre Heresy Only)" id="0273-6ac0-2a9b-9f9e" hidden="false">
                  <description>During the Great Crusade Fulgrim wielded Fireblade, wrought for him by the hand of Ferrus Manus. In games set in this era, rather than the Blade of the Laer, he is equipped with a master-crafted paragon blade which inflicts its Murderous Strike on rolls of 5+.</description>
                </rule>
              </rules>
