          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">Melee</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">7/User</characteristic>
            <characteristic name="AP" typeId="4.1502323234441545e+23">2/4</characteristic>
            <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Two-Handed, Sunder*, Cumbersome, Murderous Strike*, Concussive*</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Kontos Power Lance" id="2bd0-1acd-667c-4d23" hidden="false">
          <description>User the first profile on the turn that the model charged, including the Sunder, Murderous Strike and Concussive rules. If not use the second profile listed.</description>
        </rule>
        <rule name="Cumbersome" id="8303-d668-2b56-88eb" hidden="false" page="219" publicationId="ca571888--pubN103311">
          <description>A weapon with this type may only ever make a single attack in any given Assault phase. However, on a turn in which the bearer has charged, that attack is automatically made at Initiative step 10.</description>
        </rule>
      </rules>
    </selectionEntry>
