        <profile name="Konrad Curze" id="dfc5-891e-18dd-83b0" hidden="false" page="190" publicationId="690c-3e82-3080-6bc0" typeId="556e697423232344415441232323" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Jump Infantry (Character)</characteristic>
            <characteristic name="WS" typeId="5.753232323444154e+23">8</characteristic>
            <characteristic name="BS" typeId="4.2532323234441546e+23">6</characteristic>
            <characteristic name="S" typeId="5.323232344415441e+21">6</characteristic>
            <characteristic name="T" typeId="5.423232344415441e+21">6</characteristic>
            <characteristic name="W" typeId="5.723232344415441e+21">6</characteristic>
            <characteristic name="I" typeId="4.923232344415441e+21">7</characteristic>
            <characteristic name="A" typeId="4.123232344415441e+21">5</characteristic>
            <characteristic name="LD" typeId="4c4423232344415441232323">10</characteristic>
            <characteristic name="Save" typeId="5.361766523232344e+27">2+</characteristic>
          </characteristics>
        </profile>
        <profile name="The Nightmare Mantle" id="ad3f-19f6-a29e-d50b" hidden="false" page="190" publicationId="690c-3e82-3080-6bc0" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Provides a 2+ armour save and a 4+ Invulnerable save, and grants the Hit and Run special rule. When the Night Haunter charges, he gains the Hamer of Wrath special rule, inflicting D3 Hammer of Wrath attack rather than the usual +1 additional attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Sire of the Night Lords" id="afe4-f587-e1bb-0aff" hidden="false" page="190" publicationId="690c-3e82-3080-6bc0">
          <description>Has Night Vision and Acute Senses and may always elect to have Night Fighting for the first game turn. All units with Legiones Astartes (Night Lords) gain Fear and impose a -1 penalty to enemy units taking fear checks.</description>
        </rule>
        <rule name="The King of Terrors" id="07e2-8d64-37c9-887e" hidden="false" page="190" publicationId="690c-3e82-3080-6bc0">
          <description>Fear tests from Kurze are made at a -3 penalty.  Additionally, if Kurze is part of an assault where any enemy unit is wiped out, any units within 12&quot; that are subject to Fear must take an immediate Morale check or fall back</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="The Widowmakers" id="ea00-c053-418b-6fc5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bdb3-897b-f4cf-f4dc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
