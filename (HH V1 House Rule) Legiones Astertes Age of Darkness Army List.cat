          </costs>
          <rules>
            <rule name="Stasis Grenades" id="9411-a67b-cf5f-94d4" hidden="false" page="172" publicationId="690c-3e82-3080-6bc0">
              <description>These rare techno-relics count as neither Assault nor Defensive grenades, but have their own unique effect. During a turn in which a unit equipped with stasis grenades makes a successful charge, or are themselves successfully charged, the enemy unit(s) reduce their Initiative to 1 until the end of the game turn.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
