      <profiles>
        <profile name="The Primarch Angron" id="5c6d-7322-cd63-c1d3" hidden="false" page="26" publicationId="ca571888--pubN113187" typeId="556e697423232344415441232323" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Infantry</characteristic>
