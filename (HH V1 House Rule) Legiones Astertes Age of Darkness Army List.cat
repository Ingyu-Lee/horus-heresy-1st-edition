                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Geo-locator Beacon" id="3962-762d-b7ff-4264" hidden="false" page="237" publicationId="ca571888--pubN68042">
                  <description>Units arriving via Deep Strike which are part of the force containing the Damocles do not scatter if they choose to arrive within 24&quot;</description>
                </rule>
                <rule name="Command Vox Relay" id="17ba-6cef-154a-3acb" hidden="false" page="237" publicationId="ca571888--pubN68042">
                  <description>Allows the controlling player to add a 1 or -1 modifer to reserve rolls while in play.  Additionally, enemy models suffer a 1 to Deep Strike Mishap table rolls.</description>
                </rule>
                <rule name="Focused Bombardment" id="d1c9-29ba-0150-bad2" hidden="false" page="237" publicationId="ca571888--pubN68042">
                  <description>Once per game, may call down a bombardment in the shooting phase.  May not move in the turn it shoots this weapon.</description>
                </rule>
              </rules>
