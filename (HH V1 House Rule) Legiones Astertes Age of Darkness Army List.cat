          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">Unlimited</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">10</characteristic>
            <characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic>
            <characteristic name="Type" typeId="5.479706523232345e+27">Ordnance 1, Large Blast, Lance, Twin-linked</characteristic>
          </characteristics>
        </profile>
        <profile name="The Serpent&apos;s Scales" id="4fd3-8ed6-2cb6-e867" hidden="false" page="0" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Confers 2+ save and a 3+ Invulnerable save, and negates and psychic attack or any effect that would adversely modify his characteristic profile on a 3</characteristic>
          </characteristics>
        </profile>
        <profile name="Worldbreaker" id="e41e-ade8-2ec6-a538" hidden="false" page="0" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">10</characteristic>
            <characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic>
            <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Master-crafted, Concussive, Unwieldy</characteristic>
          </characteristics>
        </profile>
        <profile name="The Warmaster&apos;s Talon (Claw)" id="8041-6f36-24a0-3531" hidden="false" page="0" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">User</characteristic>
            <characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic>
            <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Shred, Disabling Strike</characteristic>
          </characteristics>
        </profile>
        <profile name="The Warmaster&apos;s Talon (Bolter)" id="422d-29e4-16dd-17ed" hidden="false" page="0" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">24&quot;</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">5</characteristic>
            <characteristic name="AP" typeId="4.1502323234441545e+23">3</characteristic>
            <characteristic name="Type" typeId="5.479706523232345e+27">Assault 3, Twin-linked</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Weapon Mastery" id="3d83-13b2-8cc3-97b7" hidden="false" page="0">
          <description>May wield two close combat weapons simultaneously, splitting his attacks with them in combat as desired.</description>
        </rule>
        <rule name="Sire of the Sons of Horus" id="f210-d84e-4b57-91ff" hidden="false" page="0">
          <description>When fighting a unit or character with WS 4 or less, he gains D3 attacks.  If he (any any terminator-armoured unit he joins) are in reserve, the player may choose what turn he arrives instead of rolling normally.</description>
        </rule>
        <rule name="God of Battle" id="606d-b834-d84a-957a" hidden="false" page="0">
          <description>- Any part of a force containing Horus in reserve gains Outflank
- All models with Legiones Astartes (Sons of Horus) gain 1 Ld to a max of 10
- May seize the initiative on a 4</description>
        </rule>
        <rule name="Point of the Spear" id="1ce5-0fcf-58c2-2081" hidden="false" page="0">
          <description>- Veteran Tactical squads and Justaerin Terminator squads may be taken as troops when Horus is the Warlord
- When not engaged in close combat or in reserve, Horus may call down a shooting attack once per game.</description>
        </rule>
        <rule name="Disabling Strike" id="8dac-642a-d663-2f68" hidden="false" page="0">
          <description>Any model that is wounded but not killed by The Warmasters Talon in an assault loses -1 WS and -1 Str for the remainder of the game.  This is cumulative.</description>
        </rule>
        <rule name="Teleportation Matrix" id="a5aa-7354-fc0d-41e8" hidden="false" page="0">
          <description>The Warmaster and any attached terminator-armoured unit will not scatter when entering by Deep Strike</description>
        </rule>
      </rules>
    </selectionEntry>
