          <profiles>
            <profile name="The Death of Worlds" id="8033-70b7-c373-2e9c" hidden="false" page="171" publicationId="690c-3e82-3080-6bc0" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">+5</characteristic>
                <characteristic name="AP" typeId="4.1502323234441545e+23">2</characteristic>
                <characteristic name="Type" typeId="5.479706523232345e+27">Melee, Unwieldy, Curse of Dead Worlds. *Counts as a sword for the purpose of Mastery of the Blade</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Curse of Dead Worlds" id="0df6-c995-18d5-dfed" hidden="false" page="171" publicationId="690c-3e82-3080-6bc0">
              <description>Invulnerable saves taken against hits inflicted by this weapon are reduced by -1, to a minimum of 6+ (for example, a model with a 4+ Invulnerable save struke by the Death of Worlds takes an Invulnerable save of only 5+ against the attack).</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
